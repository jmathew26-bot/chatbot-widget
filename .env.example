# Copy to .env and fill in what you have. Nothing here is required to run
# `network discover` / `network review` in offline/template mode -- the
# system degrades gracefully when a provider's credentials are absent.

# --- Database -----------------------------------------------------------
DATABASE_URL=sqlite:///./data/networking.db

# --- LLM provider (research summaries, email drafting, reply classification)
# Without this, the system falls back to a deterministic, template-based
# generator that only uses verified facts (no hallucination risk, but less
# fluent prose).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Search provider (discovery) ----------------------------------------
# Google Programmable Search Engine (https://programmablesearchengine.google.com/)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Bing Web Search (optional alternative/secondary provider)
BING_SEARCH_API_KEY=

# --- People / email discovery providers (optional, pluggable) -----------
HUNTER_API_KEY=
APOLLO_API_KEY=
PEOPLE_DATA_LABS_API_KEY=
ROCKETREACH_API_KEY=

# --- Email sending (Gmail API, OAuth) ------------------------------------
GMAIL_CREDENTIALS_JSON=./secrets/gmail_credentials.json
GMAIL_TOKEN_JSON=./secrets/gmail_token.json
GMAIL_SENDER_EMAIL=

# --- Google Calendar (OAuth, can reuse Gmail creds) ----------------------
GOOGLE_CALENDAR_CREDENTIALS_JSON=./secrets/gmail_credentials.json
GOOGLE_CALENDAR_TOKEN_JSON=./secrets/calendar_token.json
GOOGLE_CALENDAR_ID=primary

# --- Safety --------------------------------------------------------------
# Never set to true without explicitly re-reading FOLLOW-UP / APPROVAL
# sections of the design doc. The current codebase has no code path that
# reads this to bypass approval -- it exists for future, explicit wiring.
AUTONOMOUS_SENDING_ENABLED=false

# Recommended while validating real credentials end to end: caps discovery
# at 20 people per `network live-test` run and caps sends at 5/day
# regardless of daily_email_limit in config.yaml. Approval is always
# required either way -- this only lowers the volume ceiling.
LIVE_TEST_MODE=true
